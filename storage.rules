rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Institution assets ────────────────────────────────────────
    // Public read (logos/covers shown to all users)
    // Write requires authentication (admin only in practice — use Admin SDK for strict control)
    match /institutions/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024  // Max 5 MB
        && request.resource.contentType.matches('image/.*');
    }

    // ── Product images ────────────────────────────────────────────
    match /products/{allPaths=**} {
      allow read:  if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024  // Max 10 MB
        && request.resource.contentType.matches('image/.*');
    }

    // ── Deny all other paths ──────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
