rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────
    // AUTH MODEL: This app authenticates with Clerk, NOT Firebase Auth.
    // That means request.auth is ALWAYS null in these rules — we cannot use
    // it to gate access. Instead, every write and every read of private data
    // goes through server-side API routes using the Firebase Admin SDK, which
    // BYPASSES these rules entirely.
    //
    // Therefore the rule of thumb here is:
    //   • Public catalog data (institutions, departments, products, reviews):
    //     allow client READ, deny all client WRITE.
    //   • Everything private (orders, users, wishlists, tickets, subscribers,
    //     and all admin collections): DENY all client access. The Admin SDK
    //     handles it server-side after verifying the Clerk session.
    // ─────────────────────────────────────────────────────────────────────

    // ── Public catalog — client read-only ───────────────────────────────
    match /institutions/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    match /departments/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    match /products/{docId} {
      allow read:  if true;
      allow write: if false;
    }

    match /reviews/{docId} {
      // Reviews are public to read. Writes (if added later) must go through
      // an authenticated Admin SDK route, since request.auth is always null.
      allow read:  if true;
      allow write: if false;
    }

    // ── Private data — no client access at all (Admin SDK only) ──────────
    match /orders/{docId}          { allow read, write: if false; }
    match /users/{userId}          { allow read, write: if false; }
    match /wishlists/{userId}      { allow read, write: if false; }
    match /support_tickets/{docId} { allow read, write: if false; }
    match /subscribers/{docId}     { allow read, write: if false; }

    // ── Admin / system collections — no client access ────────────────────
    match /activity_logs/{docId}  { allow read, write: if false; }
    match /admins/{docId}         { allow read, write: if false; }
    match /settings/{docId}       { allow read, write: if false; }
    match /notifications/{docId}  { allow read, write: if false; }

    // ── Default deny for any collection not listed above ─────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
